# Copy this file to .env (cp .env.example .env). The real .env is never committed.
POSTGRES_DB=spotify
POSTGRES_USER=team
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db

# Where the loader downloads the CSV from (Hugging Face, no login needed).
# It downloads only if data/spotify-tracks.csv does not exist yet.
DATA_URL=https://huggingface.co/datasets/maharshipandya/spotify-tracks-dataset/resolve/main/dataset.csv
DATA_PATH=/data/spotify-tracks.csv
